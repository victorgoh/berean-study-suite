{
  "name": "berean-mcp",
  "version": "1.0.0",
  "description": "Cloudflare Worker MCP Server for Berean AI Study Suite",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx scripts/run_http_server.ts",
    "start:http": "tsx scripts/run_http_server.ts",
    "start:stdio": "tsx scripts/run_local_stdio.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "data:status": "python3 scripts/resource_data.py status",
    "data:validate": "python3 scripts/resource_data.py validate",
    "data:upload-plan": "python3 scripts/resource_data.py upload-plan",
    "test:phase4": "tsx scripts/test_phase4.ts",
    "test:commentary-ranges": "tsx scripts/test_commentary_range_intros.ts",
    "test:sword-pulpit": "tsx scripts/test_sword_pulpit_conversion.ts",
    "prepare:ecf": "python3 scripts/prepare_ecf.py",
    "shard:ecf": "python3 scripts/shard_ecf.py",
    "prepare:catena": "python3 scripts/prepare_catena.py",
    "test:catena": "tsx scripts/test_catena_conversion.ts data/commentaries/cCatena.commentary",
    "test:ecf": "tsx scripts/test_ecf_conversion.ts \"data/commentaries/cECF_{sharded}.commentary\"",
    "test:explorer": "tsx scripts/test_explorer_ui.ts",
    "test:smoke": "npm run test:phase4 && npm run test:commentary-ranges && npm run test:ecf && npm run test:explorer",
    "test": "npm run test:smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "sql.js": "^1.14.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "wrangler": "^4.126.0"
  }
}
