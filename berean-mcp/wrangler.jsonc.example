{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berean-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MCP_PROFILE": "ai"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "BIBLEMATE_DATA",
      "bucket_name": "biblemate-data"
    }
  ],
  "ratelimits": [
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_EXPENSIVE_LIMITER", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
    { "name": "MCP_BURST_LIMITER", "namespace_id": "1003", "simple": { "limit": 15, "period": 10 } }
  ],
  "d1_databases": [
    {
      "binding": "MORPHOLOGY_DB",
      "database_name": "biblemate-morphology",
      "database_id": "YOUR_D1_MORPHOLOGY_DATABASE_ID"
    },
    {
      "binding": "REFERENCE_DB",
      "database_name": "biblemate-reference",
      "database_id": "YOUR_D1_REFERENCE_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
