# Operating system files
.DS_Store
Thumbs.db
*.swp
*.swo

# Environment secrets
.env
.env.*
!.env.example

# Python bytecode/cache
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
env/
venv/

# Node / TypeScript / MCP Server build artifacts
**/node_modules/
**/dist/
**/.wrangler/
**/.mf/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Berean study outputs (keep folder structure and README)
/berean/*
!/berean/README.md
/biblemate/*

# Output exports (keep folder structure and README)
/export/*
!/export/README.md
!/export/docx/
/export/docx/*
!/export/docx/README.md
!/export/md/
/export/md/*
!/export/md/README.md

# Notes (keep folder structure and README)
/notes/*
!/notes/README.md

# Generated Images (keep folder structure and README)
/images/*
!/images/README.md

